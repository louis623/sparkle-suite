# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI model providers and Nic-Nac model policy
OPENAI_API_KEY=sk_xxx
ANTHROPIC_API_KEY=
NIC_NAC_HUMAN_DEFAULT_MODEL=gpt-5.4
NIC_NAC_HUMAN_ESCALATED_MODEL=gpt-5.5
NIC_NAC_UTILITY_MODEL=gpt-5.4-mini
NIC_NAC_LAB_SYNTHESIS_MODEL=gpt-5.5
# Agent harness rollout: production is off when all three are unset.
# Set ENABLED=false as an explicit kill switch. Prefer one exact cohort list
# before any broad ENABLED=true rollout.
NIC_NAC_AGENT_HARNESS_ENABLED=
NIC_NAC_AGENT_HARNESS_REP_IDS=
NIC_NAC_AGENT_HARNESS_EMAILS=

# Internal automation and Sparkle ecosystem linking
CRON_SECRET=replace-with-a-long-random-internal-cron-secret
SPARKLE_FINDER_TO_SUITE_REP_CLAIM_TOKEN=replace-with-a-long-random-server-token
SPARKLE_FINDER_TO_SUITE_REP_MEMORY_TOKEN=replace-with-a-long-random-server-token
SPARKLE_FINDER_TO_SUITE_INTAKE_TOKEN=replace-with-a-long-random-server-token
SPARKLE_LAB_MANUAL_RUNS_ENABLED=false
SPARKLE_LAB_WEEKLY_RUNS_ENABLED=false
SPARKLE_LAB_MODEL_SYNTHESIS_ENABLED=false

# Stripe — use sk_test_ / whsec_test_ for development, sk_live_ / whsec_ for production
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_EXPECTED_URL=

# Stripe Price IDs — create these in the Stripe Dashboard under Products
# Checkout requires one one-time build fee price plus founder and standard monthly prices.
STRIPE_PRICE_BUILD_FEE=price_xxx
STRIPE_PRICE_FOUNDER_MONTHLY=price_xxx
STRIPE_PRICE_STANDARD_MONTHLY=price_xxx

# Sparkle Suite Phase 8 payment gate Price IDs
# Leave unset until start-work and launch-fee prices are reviewed in Stripe
STRIPE_PRICE_START_WORK_FEE=
STRIPE_PRICE_LAUNCH_FEE=

# Sparkle Suite Phase 8 SignWell agreement gate
# Sending remains disabled until legal/template review is complete.
SIGNWELL_API_KEY=
SIGNWELL_API_BASE_URL=https://www.signwell.com/api/v1
SIGNWELL_TEMPLATE_ID=
SIGNWELL_TEMPLATE_RECIPIENT_PLACEHOLDER=sparkle_suite_rep
SIGNWELL_WEBHOOK_SECRET=
SIGNWELL_SEND_ENABLED=false
SIGNWELL_SANDBOX_PROVIDER_CALL=false

# App URL — used to build checkout success/cancel and portal return URLs
# Must match your actual deployment domain (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private New Rep Onboarding uses the native /onboarding/[inviteSlug] route.
# This allowlist is only for explicitly retained legacy external onboarding
# clients. New and replacement links never use these hosts.
TEAM_ONBOARDING_ALLOWED_ORIGINS=
# Optional retired Suite-owned external host compatibility flag.
TEAM_ONBOARDING_CUSTOM_DOMAIN_ENABLED=false

# Sparkle Suite self-serve and reviewer smoke mode
SPARKLE_SELF_SERVE_ENABLED=true
SPARKLE_STRIPE_TEST_BUYER_MODE=false

# Preview/local reviewer smoke mode. Never enable for production.
SPARKLE_REVIEWER_SMOKE_MODE=false
SPARKLE_REVIEWER_SMOKE_TOKEN=replace-with-a-long-random-preview-token
SPARKLE_REVIEWER_SMOKE_EMAIL=sparkle-reviewer+preview@neonrabbit.net
SPARKLE_REVIEWER_SMOKE_PASSWORD=replace-with-preview-only-password
SPARKLE_REVIEWER_SMOKE_DISPLAY_NAME=Britt Test Rep

# Prelaunch email - used for Sparkle Suite waitlist welcome email
# Must use a sender on a verified Resend domain. Display-name format is allowed.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Sparkle Suite <hello@yoursparklesuite.com>

# In-house Grok Bot notify after a public build-list / waitlist signup.
# Both must be set or the webhook is skipped. Leave empty locally.
BUILD_LIST_WEBHOOK_URL=
BUILD_LIST_WEBHOOK_KEY=

# Sparkle Suite SMS - Telnyx 10DLC
# Keep handset smoke false until a real device receives the controlled test SMS.
TELNYX_API_KEY=KEY_xxx
TELNYX_SMS_FROM=+19044383050
TELNYX_PUBLIC_KEY=
SPARKLE_SMS_CAMPAIGN_APPROVED=false
SPARKLE_SMS_NUMBER_ASSIGNED=false
SPARKLE_SMS_HANDSET_SMOKE_PASSED=false
SPARKLE_PRE_SHOW_SMS_ENABLED=false
SPARKLE_PRE_SHOW_EMAIL_ENABLED=false

# Photo enhancement — Phase 7.2/7.3 scaffold
PHOTOROOM_API_KEY=phot_xxx
PHOTOROOM_API_BASE_URL=https://image-api.photoroom.com
PHOTOROOM_TIMEOUT_MS=8000
# Read-only Nic-Nac Cost & Capacity sources. OPENAI_ADMIN_KEY must be an
# OpenAI organization admin key restricted to usage/cost reads.
OPENAI_ADMIN_KEY=
NIC_NAC_OPENAI_SUITE_PROJECT_IDS=
NIC_NAC_OPENAI_FINDER_PROJECT_IDS=
SPARKLE_FINDER_CONTROL_CENTER_USAGE_URL=https://yoursparklefinder.com/api/internal/finder/control-center-nic-nac-usage
SPARKLE_FINDER_CONTROL_CENTER_USAGE_TOKEN=
