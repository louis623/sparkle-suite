    "smoke:nic-nac:trade-board-pressure": "tsx scripts/smoke-nic-nac-trade-board-pressure.ts",
    "smoke:nic-nac:trade-swap": "tsx scripts/smoke-trade-swap.ts",
    "smoke:nic-nac:calendar-reminders": "tsx scripts/smoke-nic-nac-calendar-reminders.ts",
    "smoke:nic-nac:calendar-pressure": "tsx scripts/smoke-nic-nac-calendar-pressure.ts",
    "smoke:nic-nac:recipe-builder": "tsx scripts/smoke-nic-nac-recipe-builder.ts",
    "smoke:nic-nac:recipe-chat": "tsx scripts/smoke-nic-nac-recipe-chat.ts",
    "smoke:nic-nac:recipe-tool-contract": "npm exec vitest run tests/nic-nac/site-recipe-draft-tool.test.ts tests/nic-nac/tool-routing.test.ts tests/nic-nac/nic-nac-calendar-route-routing-smoke.test.ts tests/nic-nac-workspace-refresh-events.test.ts",
    "pressure:non-item-number-trade-listings": "tsx scripts/pressure-non-item-number-trade-listings.ts",
    "smoke:preview:vercel-curl": "tsx scripts/smoke-protected-preview-routes.ts",
    "qa:amethyst": "npm exec vitest run tests/amethyst-homepage-template.test.ts tests/amethyst-join-template.test.ts tests/amethyst-trade-template.test.ts && npm run verify:amethyst-links",
    "verify:amethyst-links": "tsx scripts/verify-amethyst-links.ts",
    "test": "vitest run tests/prepare-stripe-live-prices.test.ts tests/nic-nac/abort-modes.test.ts tests/nic-nac/add-listing-recovery.test.ts tests/nic-nac/trade-requests.test.ts tests/nic-nac/trade-board-tools.test.ts tests/nic-nac/jewelry-database.test.ts tests/nic-nac/hitl-state.test.ts tests/nic-nac/calendar-service.test.ts tests/nic-nac/calendar-tools.test.ts tests/nic-nac/site-customization-tools.test.ts tests/nic-nac/rep-notes-tools.test.ts tests/nic-nac/send-sms-notification.test.ts tests/nic-nac/send-email-notification.test.ts tests/nic-nac/get-notification-preferences.test.ts",
