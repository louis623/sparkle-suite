    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.100.1",
    "ai": "^6.0.168",
    "lucide-react": "^1.18.0",
    "next": "16.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.3.5",
