    "report:launch-readiness": "tsx scripts/run-launch-readiness-report.ts",
    "smoke:launch:restored": "tsx scripts/smoke-demo-readiness.ts --launch --categories local_static,local_app,stripe_test,stripe_local_routes,stripe_webhook_local_signature,signwell_sandbox --json --write-report",
    "smoke:launch:local-temp-demo": "tsx scripts/smoke-local-with-temporary-demo-password.ts",
    "smoke:customer-flow": "tsx scripts/smoke-customer-flow.ts",
