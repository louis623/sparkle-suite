    "smoke:nic-nac:trade-board-intake": "tsx scripts/smoke-nic-nac-trade-board-intake.ts",
    "smoke:nic-nac:trade-board-non-item-number": "tsx scripts/smoke-nic-nac-trade-board-non-item-number.ts",
    "smoke:nic-nac:remove-listing": "tsx scripts/smoke-nic-nac-remove-listing.ts",
