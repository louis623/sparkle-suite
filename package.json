{
  "name": "neon-rabbit-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "branch:check": "node scripts/check-active-branch.mjs",
    "predev": "npm run branch:check -- --operation dev",
    "dev": "next dev",
    "predev:3001": "npm run branch:check -- --operation dev:3001",
    "dev:3001": "next dev --port 3001",
    "ensure:amethyst-dev": "tsx scripts/ensure-amethyst-dev.ts",
    "prebuild": "npm run branch:check -- --operation build && npm run build:amethyst:join",
    "build": "next build",
    "build:amethyst:join": "esbuild scripts/amethyst-join-entry.jsx --bundle --minify --format=iife --platform=browser --target=es2020 --outfile=public/amethyst/join-runtime.js",
    "prestart": "npm run branch:check -- --operation start",
    "start": "next start",
    "lint": "eslint",
    "docs:import-neon-rabbit": "tsx scripts/import-neon-rabbit-drive-docs.ts",
    "photo:process-queue": "tsx scripts/process-photo-enhancement-queue.ts",
    "stripe:demo-price": "tsx scripts/prepare-stripe-demo-price.ts",
    "stripe:live-prices": "tsx scripts/prepare-stripe-live-prices.ts",
